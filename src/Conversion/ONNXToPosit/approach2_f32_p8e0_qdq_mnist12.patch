+  auto rec = [&](auto &&self, int dim, int64_t offA, int64_t offB,
+                 int64_t offO) -> void {
+    if (dim == Rank) {
+      kernel(a[offA], b[offB], o[offO]);
+      return;
+    }
+    int64_t sz = Out->sizes[dim];
+    int64_t sA = A->strides[dim];
+    int64_t sB = B->strides[dim];
+    int64_t sO = Out->strides[dim];
+    for (int64_t i = 0; i < sz; ++i) {
+      self(self, dim + 1, offA + i * sA, offB + i * sB, offO + i * sO);
+    }
+  };
+
+  rec(rec, 0, 0, 0, 0);
+}
+
+#define DEFINE_P8E0_BINARY_F32_WRAPPER(OPNAME, P8FUNC, RANK)                 \
+  extern "C" void _mlir_ciface_posit_##OPNAME##_f32_p8e0_r##RANK(            \
+      StridedMemRefType<float, RANK> *A, StridedMemRefType<float, RANK> *B,  \
+      StridedMemRefType<float, RANK> *Out) {                                 \
+    loopOverStridedMemRef<RANK>(                                             \
+        A, B, Out, [](float av, float bv, float &ov) {                       \
+          posit8_t ap = convertDoubleToP8(static_cast<double>(av));          \
+          posit8_t bp = convertDoubleToP8(static_cast<double>(bv));          \
+          posit8_t rp = P8FUNC(ap, bp);                                      \
+          ov = static_cast<float>(convertP8ToDouble(rp));                    \
+        });                                                                  \
+  }
+
